LLM_PROVIDER=

#Ollama (used for embeddings / semantic similarity only)
OLLAMA_BASE_URL=

#ollama models for local
EXTRACTOR_MODEL=

REFERENCE_MATCHER_MODEL=
EVALUATOR_MODEL=
FOLLOWUP_MODEL=

#embeddings
EMBEDDING_MODEL=nomic-embed-text

#live/cloud llm api key and model
GROQ_API_KEY=
GROQ_MODEL=

#optional: Groq request timeout (seconds) and retry count
GROQ_TIMEOUT_SECONDS=
GROQ_MAX_RETRIES=

#optional: candidate-turn cap per question when the caller sends none (default 5)
MAX_TURNS_PER_QUESTION=

#optional: when set, /v1/* endpoints require an X-API-Key header with this value
INTERVIEW_AI_API_KEY=